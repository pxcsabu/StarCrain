{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarCrane",
  "version": "0.4.4",
  "identifier": "jp.starcrane.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StarCrane",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: blob: https://skyview.gsfc.nasa.gov https://alasky.cds.unistra.fr https://alaskybis.cds.unistra.fr; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "Modern Rust Planetarium & Astronomical Suite",
    "longDescription": "StarCrane is a cross-platform astronomical simulation and planetarium desktop application inspired by Tsuru-chan's Planetarium, featuring 120k+ stars, 13k+ DSOs, 9 projections, ephemeris tools, FOV overlay, SGP4 satellite tracking, and print export.",
    "copyright": "Copyright (c) 2026 StarCrane Developers",
    "category": "Education",
    "license": "MIT",
    "licenseFile": "../THIRD_PARTY_LICENSES.md",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../assets/**/*",
      "../THIRD_PARTY_LICENSES.md"
    ],
    "windows": {
      "nsis": {
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "ja-JP"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "science"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBRjg2RENDQzZBMDA1NzEKUldSeEJhREd6RzM0Mm5RN3dYcUtrdHIvTzRsYWVwV3Y3UFM0d1c4QkZlcERRT3RkWFVmOTZSd0kK",
      "endpoints": [
        "https://github.com/pxcsabu/StarCrain/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
